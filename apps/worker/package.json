{
  "name": "@city-events/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "node --env-file-if-exists=../../.env --watch --import tsx src/index.ts",
    "lint": "eslint src",
    "start": "node --env-file-if-exists=../../.env dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@city-events/db": "workspace:*",
    "@city-events/queue": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "tsx": "4.23.13"
  }
}
