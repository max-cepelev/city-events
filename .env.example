NODE_ENV=development

# Public and internal HTTP addresses
PUBLIC_APP_URL=http://localhost:3000
API_HOST=0.0.0.0
API_PORT=3001
WEB_HOST=0.0.0.0
WEB_PORT=3000

# Local infrastructure
POSTGRES_DB=city_events
POSTGRES_USER=city_events
POSTGRES_PASSWORD=city_events_local
POSTGRES_PORT=55432
REDIS_PORT=56379
DATABASE_URL=postgresql://city_events:city_events_local@localhost:55432/city_events
REDIS_URL=redis://localhost:56379

# Better Auth requires at least 32 random bytes outside local development.
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=http://localhost:3000

# SvelteKit server-only API URL. Browser requests use same-origin /api.
INTERNAL_API_URL=http://localhost:3001

# Optional platform integrations are configured in later stages.
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
